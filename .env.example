ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000

# AI provider: "claude" (default, paid), "hf" (free Hugging Face models) or "gemini" (Google Gemini)
AI_PROVIDER=claude
# Hugging Face token: create one at https://huggingface.co/settings/tokens (Inference permission)
HF_TOKEN=hf_your_token_here
# Any vision model on Hugging Face Inference Providers
HF_MODEL=google/gemma-4-31B-it:novita
# Google Gemini: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
