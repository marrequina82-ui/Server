PORT=4000

# Firebase Admin: path to the service-account key from
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Discord sign-in (optional): discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# AI provider: "claude" (default, via n8n), "hf" (free Hugging Face models), "gemini" (Google Gemini) or "ollama" (local)
AI_PROVIDER=claude
N8N_BASE_URL=http://localhost:5678
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# Hugging Face token: create one at https://huggingface.co/settings/tokens (Inference permission)
HF_TOKEN=hf_your_token_here
# Any vision model on Hugging Face Inference Providers
HF_MODEL=google/gemma-4-31B-it:novita
# Google Gemini: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava

# Optional: where the SQLite file lives (default ./fittonesugo.db)
# DB_PATH=./fittonesugo.db
